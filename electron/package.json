{
  "name": "freiraum-mitarbeiter",
  "version": "0.2.0",
  "main": "main.js",
  "private": true,
  "scripts": {
    "start": "electron .",
    "start:dev": "set FM_ELECTRON_MODE=dev&& set FM_START_BACKEND_DEV=1&& electron .",
    "start:renderer": "set FM_ELECTRON_MODE=dev&& electron .",
    "build": "set FM_ELECTRON_MODE=prod&& electron-builder --win nsis"
  },
  "dependencies": {},
  "devDependencies": {
    "electron": "^31.0.0",
    "electron-builder": "^24.13.3"
  },
  "build": {
    "appId": "de.freiraum.mitarbeiter",
    "productName": "Freiraum Mitarbeiter",
    "directories": {
      "output": "../installers",
      "buildResources": "../assets"
    },
    "files": [
      "main.js",
      "preload.js",
      "app/**"
    ],
    "extraResources": [
      {
        "from": "../backend/dist/backend_server",
        "to": "backend/backend_server",
        "filter": [
          "**/*"
        ]
      }
    ],
    "win": {
      "target": "nsis",
      "icon": "../assets/logo.ico",
      "signAndEditExecutable": false,
      "verifyUpdateCodeSignature": false
    },
    "nsis": {
      "oneClick": true,
      "perMachine": false,
      "allowToChangeInstallationDirectory": false,
      "artifactName": "Freiraum-Mitarbeiter-Setup-${version}.exe"
    }
  }
}
